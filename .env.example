# Warehouse: DuckDB file for local dev, or a Postgres URL in production (Railway)
WAREHOUSE_URL=duckdb:///warehouse/immodash.duckdb
# WAREHOUSE_URL=postgresql+psycopg://immodash:<POSTGRES_PASSWORD>@localhost:5432/immodash

# dbt target: dev (duckdb) or prod (postgres)
DBT_TARGET=dev

# Dashboard reads from this API
API_URL=http://localhost:8000

# Optional: Zensus 2022 database API token (https://ergebnisse.zensus2022.de). Without it the
# pipeline uses the CSV export committed under data/raw/zensus/.
ZENSUS_API_TOKEN=

# Local Postgres stack (docker compose): required, there is no default password
POSTGRES_PASSWORD=
# API: allowed browser origins (comma separated); default is the public site only
# CORS_ORIGINS=http://localhost:8050
